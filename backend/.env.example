# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/vedaai

# Redis (Upstash compatible). For Upstash use the rediss:// TLS URL.
REDIS_URL=redis://localhost:6379

# LLM provider key (Groq recommended — fast + free)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# Local file uploads (relative to backend/)
UPLOADS_DIR=uploads

# Set to "false" to disable in-process worker (e.g. when running `npm run worker` separately)
START_WORKER=true

# Server
PORT=8000
FRONTEND_URL=http://localhost:3000
